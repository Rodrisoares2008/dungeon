-- Função: gera loadstring a partir do snapshot atual
local function generateConfigLoadstring()
    local snap = getCurrentSnapshot()
    local encoded = HttpService:JSONEncode(snap)
    local escaped = encoded:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n"):gsub("\r", "\\r")
    return '_G.NightHubConfigPending = game:GetService("HttpService"):JSONDecode("' .. escaped .. '")'
end

