local PLAYER_RADIUS = 3
local DODGE_MARGIN = 3
local DODGE_DETECT_BUFFER = 12

local function isAttackIndicator(obj)
    if not obj:IsA("BasePart") then return false end
    local char = LocalPlayer.Character
    if char and char:IsAncestorOf(obj) then return false end

    local size = obj.Size
    local isFlat = size.Y < 3 and (size.X > 4 or size.Z > 4)
    if isFlat then
        local r, g, b = obj.Color.R, obj.Color.G, obj.Color.B
        local isPurple = (r > 0.3 and b > 0.3 and g < 0.5)
        if isPurple and obj.Transparency > 0.2 then
            return true, "ground"
        end
    end

    local isBeam = (size.X < 2 and size.Y < 2 and size.Z > 8) or (size.X > 8 and size.Y < 2 and size.Z < 2) or (size.X < 2 and size.Y > 8 and size.Z < 2)
    if isBeam then
        local r, g, b = obj.Color.R, obj.Color.G, obj.Color.B
        local isPurple = (r > 0.3 and b > 0.3 and g < 0.5)
        if isPurple then
            return true, "beam"
        end
    end

    return false, nil
end

local function isDodgeBoundsSafe(pos)
    if not pos then return false end
    if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
    if pos.Y > 1000 or pos.Y < -800 then return false end
    if pos.Magnitude > 50000 then return false end
    return true
end

local function hasSolidFloorBelow(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {}
    local char = LocalPlayer.Character
    if char then filter[#filter + 1] = char end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(pos + Vector3.new(0, 6, 0), Vector3.new(0, -45, 0), params)
    if result then
        local inst = result.Instance
        if inst and inst:IsA("BasePart") and inst.CanCollide then
            return true
        end
    end
    return false
end

local function isDodgePathClear(fromPos, toPos)
    local delta = toPos - fromPos
    if delta.Magnitude < 0.5 then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {}
    local char = LocalPlayer.Character
    if char then filter[#filter + 1] = char end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(fromPos + Vector3.new(0, 1.5, 0), delta, params)
    if not result then return true end
    local inst = result.Instance
    if inst and inst:IsA("BasePart") and inst.CanCollide then
        return false
    end
    return true
end

local function clearsAllDangers(dangers, cand)
    for _, d in ipairs(dangers) do
        local dx = cand.X - d.center.X
        local dz = cand.Z - d.center.Z
        if math.sqrt(dx * dx + dz * dz) < d.radius + PLAYER_RADIUS + 1 then
            return false
        end
    end
    return true
end

local function isDodgePosSafe(fromPos, p)
    if not isDodgeBoundsSafe(p) then return false end
    if not isDodgePathClear(fromPos, p) then return false end
    if not hasSolidFloorBelow(p) then return false end
    return true
end

local function getDodgePosition(rootPart)
    if not rootPart then return nil end
    local now = tick()
    if (now - _lastDodgeTime) < DODGE_COOLDOWN then return nil end

    local playerPos = rootPart.Position
    local dangers = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj == rootPart then continue end
        local char = LocalPlayer.Character
        if char and char:IsAncestorOf(obj) then continue end
        if not obj:IsA("BasePart") then continue end

        local isDanger, dangerType = isAttackIndicator(obj)
        if not isDanger then continue end

        local nearest = obj.Position
        local radius
        local dx
        local dz
        if dangerType == "ground" then
            radius = math.max(obj.Size.X, obj.Size.Z) / 2
            dx = obj.Position.X - playerPos.X
            dz = obj.Position.Z - playerPos.Z
        else
            radius = 4
            local size = obj.Size
            local ax
            local axisDir
            if size.X >= size.Z and size.X >= size.Y then
                ax = size.X
                axisDir = obj.CFrame.RightVector
            elseif size.Z >= size.Y then
                ax = size.Z
                axisDir = obj.CFrame.LookVector
            else
                ax = size.Y
                axisDir = obj.CFrame.UpVector
            end
            axisDir = axisDir.Unit
            local halfLen = math.min(ax / 2, 44)
            local t = math.clamp((playerPos - obj.Position):Dot(axisDir), -halfLen, halfLen)
            nearest = obj.Position + axisDir * t
            dx = nearest.X - playerPos.X
            dz = nearest.Z - playerPos.Z
        end
        local hDist = math.sqrt(dx * dx + dz * dz)
        if hDist < radius + DODGE_DETECT_BUFFER then
            dangers[#dangers + 1] = { center = nearest, radius = radius, hDist = hDist }
        end
    end

    if #dangers == 0 then return nil end

    local best = dangers[1]
    local bestU = -math.huge
    for _, d in ipairs(dangers) do
        local u = (d.radius + PLAYER_RADIUS + DODGE_MARGIN) - d.hDist
        if u > bestU then
            bestU = u
            best = d
        end
    end

    local away = Vector3.new(playerPos.X - best.center.X, 0, playerPos.Z - best.center.Z)
    if away.Magnitude < 0.001 then away = Vector3.new(1, 0, 0) end
    away = away.Unit
    local req = best.radius + PLAYER_RADIUS + DODGE_MARGIN
    local playerAng = math.atan2(away.Z, away.X)

    local candidates = {}
    candidates[#candidates + 1] = { ang = 0, extra = 0 }
    local angOffsets = { 0.35, 0.7, 1.05, 1.4, 2.1, 2.8 }
    for _, o in ipairs(angOffsets) do
        candidates[#candidates + 1] = { ang = o, extra = 0 }
        candidates[#candidates + 1] = { ang = -o, extra = 0 }
    end
    for i = 1, 3 do
        candidates[#candidates + 1] = { ang = 0, extra = i * 5 }
    end
    table.sort(candidates, function(a, b)
        return (math.abs(a.ang) + a.extra) < (math.abs(b.ang) + b.extra)
    end)

    for _, cand in ipairs(candidates) do
        local a = playerAng + cand.ang
        local reqR = req + cand.extra
        local p = Vector3.new(best.center.X + math.cos(a) * reqR, playerPos.Y, best.center.Z + math.sin(a) * reqR)
        if not isDodgePosSafe(playerPos, p) then continue end
        if not clearsAllDangers(dangers, p) then continue end
        _lastDodgeTime = now
        return p
    end

    return nil
end

local _dodgeUntil = 0
local _dodgeDir = Vector3.new(0, 0, 0)

local function detectAoEDodge(rootPart)
    if not bv or not bg then return false end
    local now = tick()
    if now < _dodgeUntil then
        if _dodgeDir.Magnitude > 0.05 then
            bv.Parent = rootPart
            bg.Parent = rootPart
            bv.Velocity = _dodgeDir * NightHub.FlightSpeed
            bg.CFrame = CFrame.new(rootPart.Position, rootPart.Position + _dodgeDir)
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end
        return true
    end
    local dodgePos = getDodgePosition(rootPart)
    if not dodgePos then return false end
    local dir = dodgePos - rootPart.Position
    _dodgeUntil = now + 0.4
    if dir.Magnitude > 0.7 then
        _dodgeDir = dir.Unit
        bv.Parent = rootPart
        bg.Parent = rootPart
        bv.Velocity = _dodgeDir * NightHub.FlightSpeed
        bg.CFrame = CFrame.new(rootPart.Position, dodgePos)
    else
        _dodgeDir = Vector3.new(0, 0, 0)
        bv.Velocity = Vector3.new(0, 0, 0)
    end
    return true
end

function iniciarFarm()
    if not updateFarmChar() then return end
    
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    end
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bg.P = 20000
    end
    
    farmFlying = true
    bv.Parent = farmRoot
    bg.Parent = farmRoot
    farmHum.PlatformStand = true
    
    -- Noclip
    local farmNoclipParts = {}
    for _, part in ipairs(farmChar:GetChildren()) do
        if part:IsA("BasePart") then farmNoclipParts[#farmNoclipParts + 1] = part end
    end
    for _, acc in ipairs(farmChar:GetChildren()) do
        if acc:IsA("Accessory") then
            local handle = acc:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then farmNoclipParts[#farmNoclipParts + 1] = handle end
        end
    end
    if Connections.FarmNoclip then Connections.FarmNoclip:Disconnect() end
    Connections.FarmNoclip = RunService.Stepped:Connect(function()
        if farmFlying then
            for i = 1, #farmNoclipParts do
                local p = farmNoclipParts[i]
                if p and p.Parent then p.CanCollide = false end
            end
        end
    end)
    
    -- Busca de Alvo (detecta VoidShades, Gregg e Ground NPCs)
    local targetSearchRunning = true
    local greggFound = false
    local orbitWasAuto = false
    local lastFarmScanTime = 0
    local FARM_SCAN_INTERVAL = 0.2
    if Connections.FarmTargetSearch then Connections.FarmTargetSearch:Disconnect() end
    Connections.FarmTargetSearch = task.spawn(function()
        while targetSearchRunning and NightHub.FarmAtivo do
            pcall(function()
                if not updateFarmChar() then return end

                local now = tick()
                if now - lastFarmScanTime < FARM_SCAN_INTERVAL then
                    task.wait(0.05)
                    return
                end
                lastFarmScanTime = now
                
                local bossFound = false
                local closestNormal = nil
                local closestNormalModel = nil
                local closestVoid = nil
                local closestVoidModel = nil
                local closestGregg = nil
                local closestGreggModel = nil
                local closestCorrupted = nil
                local closestCorruptedModel = nil
                local closestReaver = nil
                local closestReaverModel = nil
                local shortestNormal = NightHub.MaxDetectionRange
                local shortestVoid = NightHub.MaxDetectionRange
                local shortestGregg = NightHub.MaxDetectionRange
                local shortestCorrupted = NightHub.MaxDetectionRange
                local shortestReaver = NightHub.MaxDetectionRange
                
                local npcList = fastScanNPCs(farmChar, farmRoot.Position, NightHub.MaxDetectionRange)

                for _, npc in ipairs(npcList) do
                    local model = npc.model
                    local targetPart = npc.root
                    local d = (targetPart.Position - farmRoot.Position).Magnitude
                    local nameLower = string.lower(model.Name)
                    
                    if string.find(nameLower, "adelys") then
                        print("[Farm] Boss Adelys detectado — NPCs pre-boss eliminados. Parando farm em 1588, -487, 109.")
                        targetSearchRunning = false
                        hitboxRunning = false
                        NightHub.FarmAtivo = false
                        UpdateUIToggle("Farm", false)
                        task.spawn(pararFarm)
                        return
                    elseif string.find(nameLower, "the voidborn") then
                        currentBoss = "The Voidborn"
                        bossFound = true
                        bossLastSeen = tick()
                        waitingForVoidborn = false
                    elseif string.find(nameLower, "gregg") then
                        if d < shortestGregg and d < 80 then
                            shortestGregg = d
                            closestGregg = targetPart
                            closestGreggModel = model
                        end
                    elseif isCorruptedGrowth(model.Name) then
                        if d < shortestCorrupted then
                            shortestCorrupted = d
                            closestCorrupted = targetPart
                            closestCorruptedModel = model
                        end
                    elseif isVoidShade(model.Name) then
                        if d < shortestVoid then
                            shortestVoid = d
                            closestVoid = targetPart
                            closestVoidModel = model
                        end
                    elseif isEldritchReaver(model.Name) then
                        if d < shortestReaver then
                            shortestReaver = d
                            closestReaver = targetPart
                            closestReaverModel = model
                        end
                    else
                        if d < shortestNormal then
                            shortestNormal = d
                            closestNormal = targetPart
                            closestNormalModel = model
                        end
                    end
                end
                
                -- Boss cooldown: manter posicao por Xs apos boss morrer
                -- Nota: Adelys nunca chega aqui pois o farm para ao detecta-lo
                if not bossFound and currentBoss then
                    local cd = BossPositions[currentBoss] and BossPositions[currentBoss].cooldown or 4
                    if (tick() - bossLastSeen) >= cd then
                        if currentBoss == "The Voidborn" then
                            bossPhase = 0
                        end
                        currentBoss = nil
                    else
                        currentTarget = nil
                        currentTargetModel = nil
                        isCurrentVoidShade = false
                        isCurrentGroundNPC = false
                        return
                    end
                end
                
                -- Reset sempre antes de procurar targets
                currentTarget = nil
                currentTargetModel = nil
                isCurrentVoidShade = false
                isCurrentGroundNPC = false
                isCurrentReaver = false
                
                -- Boss The Voidborn tem prioridade total
                if currentBoss == "The Voidborn" then
                    isCurrentReaver = false
                -- Gregg tem prioridade máxima
                elseif closestGregg then
                    if not greggFound then
                        greggFound = true
                        orbitWasAuto = not NightHub.OrbitMode
                        NightHub.OrbitMode = true
                    end
                    currentTarget = closestGregg
                    currentTargetModel = closestGreggModel
                    isCurrentVoidShade = false
                    isCurrentGroundNPC = false
                    isCurrentReaver = false
                else
                    -- Gregg morreu ou desapareceu, desativa orbit auto
                    if greggFound then
                        greggFound = false
                        if orbitWasAuto then
                            NightHub.OrbitMode = false
                            orbitWasAuto = false
                        end
                    end
                    -- Prioridade: Normais = Corrupted Growth > Voidshade > Eldritch Reaver
                    if closestNormal then
                        currentTarget = closestNormal
                        currentTargetModel = closestNormalModel
                        isCurrentVoidShade = false
                        isCurrentGroundNPC = false
                        isCurrentReaver = false
                    elseif closestCorrupted then
                        currentTarget = closestCorrupted
                        currentTargetModel = closestCorruptedModel
                        isCurrentVoidShade = false
                        isCurrentGroundNPC = true
                        isCurrentReaver = false
                    elseif closestVoid then
                        currentTarget = closestVoid
                        currentTargetModel = closestVoidModel
                        isCurrentVoidShade = true
                        isCurrentGroundNPC = false
                        isCurrentReaver = false
                    elseif closestReaver then
                        currentTarget = closestReaver
                        currentTargetModel = closestReaverModel
                        isCurrentVoidShade = false
                        isCurrentGroundNPC = false
                        isCurrentReaver = true
                    end
                end
            end)
            task.wait(0.3)
        end
    end)
    
    -- Hitbox
    local hitboxRunning = true
    if Connections.FarmHitbox then Connections.FarmHitbox:Disconnect() end
    Connections.FarmHitbox = task.spawn(function()
        while hitboxRunning and NightHub.FarmAtivo do
            pcall(function()
                local npcList = fastScanNPCs(farmChar, nil, nil)
                for _, npc in ipairs(npcList) do
                    local targetPart = npc.root
                    if targetPart and targetPart.Size.Y < NightHub.HitboxSize then
                        targetPart.Size = Vector3.new(NightHub.HitboxSize, NightHub.HitboxSize, NightHub.HitboxSize)
                        targetPart.Transparency = 1
                        targetPart.CanCollide = false
                    end
                end
            end)
            task.wait(2)
        end
    end)
    
    -- Loop de Movimento
    if Connections.FarmMovement then Connections.FarmMovement:Disconnect() end
    local farmFrameCount = 0
    local function isFarmSafePos(pos)
        if not pos then return false end
        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
        if pos.Y > 1000 or pos.Y < -800 then return false end
        if pos.Magnitude > 50000 then return false end
        return true
    end
    Connections.FarmMovement = RunService.Heartbeat:Connect(function()
        if not farmFlying or not NightHub.FarmAtivo then return end
        farmFrameCount = farmFrameCount + 1
        if farmFrameCount % 2 ~= 0 then return end
        
        pcall(function()
            if not updateFarmChar() then return end

            if detectAoEDodge(farmRoot) then return end

            if waitingForVoidborn then
                bv.Parent = farmRoot
                bg.Parent = farmRoot
                local bPos = BossPositions["The Voidborn"].pos
                if not isFarmSafePos(bPos) then return end
                local direction = (bPos - farmRoot.Position)
                if direction.Magnitude > 2 then
                    bv.Velocity = direction.Unit * NightHub.FlightSpeed
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
                bg.CFrame = CFrame.new(farmRoot.Position, Vector3.new(bPos.X, farmRoot.Position.Y, bPos.Z))
                if (tick() - voidbornWaitStart) >= 5 then
                    waitingForVoidborn = false
                end
                return
            end

            if currentBoss == "The Voidborn" then
                bv.Parent = farmRoot
                bg.Parent = farmRoot
                local bPos = BossPositions["The Voidborn"].pos
                if not isFarmSafePos(bPos) then return end
                local direction = (bPos - farmRoot.Position)
                if direction.Magnitude > 2 then
                    bv.Velocity = direction.Unit * NightHub.FlightSpeed
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
                bg.CFrame = CFrame.new(farmRoot.Position, Vector3.new(bPos.X, farmRoot.Position.Y, bPos.Z))
                return
            end
            
            local goToBoss = false
            if currentBoss and BossPositions[currentBoss] then
                if currentTarget and currentTarget:IsA("BasePart") and currentTarget.Parent then
                    goToBoss = false
                else
                    goToBoss = true
                end
            end

            if goToBoss then
                local bossPos = BossPositions[currentBoss].pos
                if not isFarmSafePos(bossPos) then return end
                local direction = (bossPos - farmRoot.Position)
                bv.Parent = farmRoot
                bg.Parent = farmRoot
                if direction.Magnitude > 2 then
                    bv.Velocity = direction.Unit * NightHub.FlightSpeed
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
                bg.CFrame = CFrame.new(farmRoot.Position, Vector3.new(bossPos.X, farmRoot.Position.Y, bossPos.Z))
            elseif currentTarget and currentTarget:IsA("BasePart") and currentTarget.Parent then
                bv.Parent = farmRoot
                bg.Parent = farmRoot
                local targetPos = currentTarget.Position
                if not isFarmSafePos(targetPos) then return end
                
                if NightHub.OrbitMode then
                    orbitAngle = orbitAngle + 0.03
                    local orbitRadius = 4
                    local orbitX = math.cos(orbitAngle) * orbitRadius
                    local orbitZ = math.sin(orbitAngle) * orbitRadius
                    local orbitPos = targetPos + Vector3.new(orbitX, 0, orbitZ)
                    
                    local direction = (orbitPos - farmRoot.Position)
                    if direction.Magnitude > 1 then
                        bv.Velocity = direction.Unit * NightHub.FlightSpeed
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end
                    
                    bg.CFrame = CFrame.new(farmRoot.Position, Vector3.new(targetPos.X, farmRoot.Position.Y, targetPos.Z))
                elseif isCurrentVoidShade and currentTargetModel then
                    local voidLook = currentTarget.CFrame.LookVector
                    local behind = -voidLook
                    local lowestY = getLowestPartY(currentTargetModel)
                    if not lowestY or lowestY > targetPos.Y + 5 then lowestY = targetPos.Y - 5 end
                    local baseY = math.max(lowestY, targetPos.Y - 5)
                    local backX = targetPos.X + behind.X * 8
                    local backZ = targetPos.Z + behind.Z * 8
                    local groundPos = Vector3.new(backX, baseY, backZ)

                    local direction = (groundPos - farmRoot.Position)
                    if direction.Magnitude > 1 then
                        bv.Velocity = direction.Unit * NightHub.FlightSpeed
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end

                    bg.CFrame = CFrame.new(farmRoot.Position, Vector3.new(targetPos.X, farmRoot.Position.Y, targetPos.Z))
                elseif isCurrentReaver and currentTargetModel then
                    local lowestY = getLowestPartY(currentTargetModel)
                    if not lowestY or lowestY > targetPos.Y + 5 then lowestY = targetPos.Y - 5 end
                    local sideOffset = currentTarget.CFrame.RightVector * 10
                    local destX = targetPos.X + sideOffset.X
                    local destZ = targetPos.Z + sideOffset.Z
                    local destY = math.max(lowestY - 15, targetPos.Y - 25)
                    local groundY = getGroundYAt(currentTargetModel, destY, Vector3.new(destX, destY, destZ))
                    local groundPos = Vector3.new(destX, math.max(lowestY - 15, groundY + 3), destZ)

                    local direction = (groundPos - farmRoot.Position)
                    if direction.Magnitude > 0.5 then
                        bv.Velocity = direction.Unit * NightHub.FlightSpeed
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end

                    bg.CFrame = CFrame.new(farmRoot.Position, Vector3.new(targetPos.X, farmRoot.Position.Y, targetPos.Z))
                elseif isCurrentGroundNPC and currentTargetModel then
                    local lowestY = getLowestPartY(currentTargetModel)
                    if not lowestY or lowestY > targetPos.Y + 5 then lowestY = targetPos.Y - 5 end
                    local baseY = math.max(lowestY, targetPos.Y - 5)

                    local awayDir = (farmRoot.Position - targetPos)
                    awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
                    if awayDir.Magnitude < 1 then
                        awayDir = Vector3.new(1, 0, 0)
                    end
                    awayDir = awayDir.Unit

                    local destX = targetPos.X + awayDir.X * 50
                    local destZ = targetPos.Z + awayDir.Z * 50
                    local destPos = Vector3.new(destX, baseY, destZ)
                    local groundY = getGroundYAt(currentTargetModel, baseY, destPos)
                    local groundPos = Vector3.new(destX, groundY, destZ)

                    if tick() - _lastCGDebug > 1 then
                        _lastCGDebug = tick()
                        print("[CG-FARM] npcY=" .. tostring(targetPos.Y) .. " baseY=" .. tostring(baseY) .. " groundY=" .. tostring(groundY) .. " dest=" .. tostring(groundPos))
                    end

                    local direction = (groundPos - farmRoot.Position)
                    if direction.Magnitude > 1 then
                        bv.Velocity = direction.Unit * NightHub.FlightSpeed
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end

                    bg.CFrame = CFrame.new(farmRoot.Position, Vector3.new(targetPos.X, farmRoot.Position.Y, targetPos.Z))
                else
                    local lowestY = getLowestPartY(currentTargetModel)
                    if not lowestY or lowestY > targetPos.Y + 5 then lowestY = targetPos.Y - 5 end
                    local baseY = math.max(lowestY, targetPos.Y - 5)
                    local sideOffset = currentTarget.CFrame.RightVector * 25
                    local posX = targetPos.X + sideOffset.X
                    local posZ = targetPos.Z + sideOffset.Z
                    local groundPos = Vector3.new(posX, baseY, posZ)

                    local direction = (groundPos - farmRoot.Position)
                    if direction.Magnitude > 1 then
                        bv.Velocity = direction.Unit * NightHub.FlightSpeed
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end
                    bg.CFrame = CFrame.new(farmRoot.Position, Vector3.new(targetPos.X, farmRoot.Position.Y, targetPos.Z))
                end
            else
                orbitAngle = 0
                bv.Parent = nil
                bg.Parent = nil
            end
        end)
    end)
end

function pararFarm()
    farmFlying = false
    currentTarget = nil
    currentTargetModel = nil
    isCurrentVoidShade = false
    isCurrentGroundNPC = false
    isCurrentReaver = false
    currentBoss = nil
    bossPhase = 0
    waitingForVoidborn = false
    voidbornWaitStart = 0
    orbitAngle = 0
    NightHub.FarmAtivo = false
    
    if bv and not NightHub.FlyAtivo then
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = nil
    end
    if bg and not NightHub.FlyAtivo then
        bg.Parent = nil
    end
    
    pcall(function()
        if updateFarmChar() and not NightHub.FlyAtivo then
            farmHum.PlatformStand = false
        end
    end)
    
    if Connections.FarmNoclip then Connections.FarmNoclip:Disconnect(); Connections.FarmNoclip = nil end
    if Connections.FarmTargetSearch then pcall(task.cancel, Connections.FarmTargetSearch); Connections.FarmTargetSearch = nil end
    if Connections.FarmHitbox then pcall(task.cancel, Connections.FarmHitbox); Connections.FarmHitbox = nil end
    if Connections.FarmMovement then Connections.FarmMovement:Disconnect(); Connections.FarmMovement = nil end
end

-- =========================================================================
-- NoVFX (MODO FPS MAX - remove paredes, texturas, chao roxo, mantem NPCs e ataques visiveis)
-- =========================================================================
local NoVFXObjects = {}
local NoVFXPartData = {}

local function isPartOfNPC(obj)
    local p = obj
    while p and p ~= workspace do
        if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then
            return true
        end
        p = p.Parent
    end
    return false
end

local function optimizePartForFPS(obj)
    if not obj:IsA("BasePart") then return end
    if isPartOfNPC(obj) then return end
    pcall(function()
        if not NoVFXPartData[obj] then
            NoVFXPartData[obj] = {
                Color = obj.Color,
                Material = obj.Material,
                Transparency = obj.Transparency,
                Reflectance = obj.Reflectance,
            }
        end
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") then
                if not NoVFXPartData[child] then
                    NoVFXPartData[child] = { Transparency = child.Transparency }
                end
                child.Transparency = 1
            elseif child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
                if not NoVFXPartData[child] then
                    NoVFXPartData[child] = { Enabled = child.Enabled }
                end
                child.Enabled = false
            elseif child:IsA("SpecialMesh") or child:IsA("BlockMesh") or child:IsA("CylinderMesh") then
                if not NoVFXPartData[child] then
                    NoVFXPartData[child] = { Scale = child.Scale }
                end
                child.Scale = Vector3.new(0.001, 0.001, 0.001)
            end
        end
        obj.Reflectance = 0
        obj.Material = Enum.Material.SmoothPlastic
        local isFloor = obj.Size.Y < 6 and (obj.Size.X > 15 or obj.Size.Z > 15)
        if isFloor then
            obj.Color = Color3.fromRGB(155, 125, 185)
        else
            obj.Transparency = 1
        end
    end)
end

local function simplifyNPCParts()
    local function scan(folder)
        for _, v in pairs(folder:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") then
                for _, part in ipairs(v:GetDescendants()) do
                    if part:IsA("BasePart") then
                        pcall(function()
                            if not NoVFXPartData[part] then
                                NoVFXPartData[part] = {
                                    Material = part.Material,
                                    Reflectance = part.Reflectance,
                                }
                            end
                            part.Material = Enum.Material.SmoothPlastic
                            part.Reflectance = 0
                            for _, child in ipairs(part:GetChildren()) do
                                if child:IsA("Decal") or child:IsA("Texture") then
                                    if not NoVFXPartData[child] then
                                        NoVFXPartData[child] = { Transparency = child.Transparency }
                                    end
                                    child.Transparency = 1
                                elseif child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
                                    if not NoVFXPartData[child] then
                                        NoVFXPartData[child] = { Enabled = child.Enabled }
                                    end
                                    child.Enabled = false
                                elseif child:IsA("SpecialMesh") or child:IsA("BlockMesh") or child:IsA("CylinderMesh") then
                                    if not NoVFXPartData[child] then
                                        NoVFXPartData[child] = { Scale = child.Scale }
                                    end
                                    child.Scale = Vector3.new(0.001, 0.001, 0.001)
                                end
                            end
                        end)
                    end
                end
            elseif v:IsA("Folder") then
                scan(v)
            end
        end
    end
    scan(workspace)
end

local function disableVFX(obj)
    if not NightHub.NoVFXAtivo then return end
    pcall(function()
        local cn = obj.ClassName

        if cn == "ParticleEmitter" or cn == "Trail" or cn == "Beam"
            or cn == "Fire" or cn == "Smoke" or cn == "Sparkles"
            or cn == "Explosion" or cn == "SpotLight" or cn == "PointLight"
            or cn == "SurfaceLight" or cn == "ShurikenEmitter" then
            obj.Enabled = false
            table.insert(NoVFXObjects, obj)

        elseif cn == "Sound" then
            obj.Volume = 0
            table.insert(NoVFXObjects, obj)

        elseif cn == "SurfaceGui" or cn == "BillboardGui" then
            obj.Enabled = false
            table.insert(NoVFXObjects, obj)

        elseif cn == "Decal" or cn == "Texture" then
            obj.Transparency = 1
            table.insert(NoVFXObjects, obj)
        end
    end)
end

function ativarNoVFX()
    if Connections.VFX then Connections.VFX:Disconnect() end
    if Connections.VFXOptimize then Connections.VFXOptimize:Disconnect() end

    local function scanAll(folder)
        for _, obj in pairs(folder:GetChildren()) do
            disableVFX(obj)
            pcall(optimizePartForFPS, obj)
            if obj:IsA("Folder") or (obj:IsA("Model") and not obj:FindFirstChildOfClass("Humanoid")) then
                scanAll(obj)
            end
        end
    end
    scanAll(workspace)

    pcall(simplifyNPCParts)

    Connections.VFX = workspace.DescendantAdded:Connect(disableVFX)
    Connections.VFXOptimize = workspace.DescendantAdded:Connect(function(obj)
        task.wait()
        pcall(optimizePartForFPS, obj)
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            for _, part in ipairs(obj:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        if not NoVFXPartData[part] then
                            NoVFXPartData[part] = {
                                Material = part.Material,
                                Reflectance = part.Reflectance,
                            }
                        end
                        part.Material = Enum.Material.SmoothPlastic
                        part.Reflectance = 0
                        for _, child in ipairs(part:GetChildren()) do
                            if child:IsA("Decal") or child:IsA("Texture") then
                                if not NoVFXPartData[child] then
                                    NoVFXPartData[child] = { Transparency = child.Transparency }
                                end
                                child.Transparency = 1
                            elseif child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
                                if not NoVFXPartData[child] then
                                    NoVFXPartData[child] = { Enabled = child.Enabled }
                                end
                                child.Enabled = false
                            elseif child:IsA("SpecialMesh") or child:IsA("BlockMesh") or child:IsA("CylinderMesh") then
                                if not NoVFXPartData[child] then
                                    NoVFXPartData[child] = { Scale = child.Scale }
                                end
                                child.Scale = Vector3.new(0.001, 0.001, 0.001)
                            end
                        end
                    end)
                end
            end
        end
    end)

    pcall(function()
        local l = game:GetService("Lighting")
        l.GlobalShadows = false
        l.EnvironmentDiffuseScale = 0
        l.EnvironmentSpecularScale = 0
        l.ShadowSoftness = 0
        l.Brightness = 1
        l.ClockTime = 12
        l.FogEnd = 500
        l.FogStart = 0

        for _, effect in ipairs(l:GetDescendants()) do
            if effect:IsA("Atmosphere") or effect:IsA("Sky") or effect:IsA("BloomEffect")
                or effect:IsA("ColorCorrectionEffect") or effect:IsA("SunRaysEffect")
                or effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect") then
                effect.Enabled = false
                table.insert(NoVFXObjects, effect)
            end
        end
    end)

    print("[NoVFX] Paredes ocultas, texturas removidas, chao roxo, FPS maximizado!")
end

function desativarNoVFX()
    for _, obj in ipairs(NoVFXObjects) do
        pcall(function()
            if obj and obj.Parent then
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                    or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
                    or obj:IsA("SpotLight") or obj:IsA("PointLight") or obj:IsA("SurfaceLight") then
                    obj.Enabled = true
                elseif obj:IsA("Sound") then
                    obj.Volume = 0.5
                elseif obj:IsA("Atmosphere") or obj:IsA("Sky") or obj:IsA("BloomEffect")
                    or obj:IsA("ColorCorrectionEffect") or obj:IsA("SunRaysEffect")
                    or obj:IsA("BlurEffect") or obj:IsA("DepthOfFieldEffect") then
                    obj.Enabled = true
                elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
                    obj.Enabled = true
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = 0
                end
            end
        end)
    end
    NoVFXObjects = {}

    for obj, data in pairs(NoVFXPartData) do
        pcall(function()
            if obj and obj.Parent then
                if data.Color then obj.Color = data.Color end
                if data.Material then obj.Material = data.Material end
                if data.Transparency ~= nil then obj.Transparency = data.Transparency end
                if data.Reflectance then obj.Reflectance = data.Reflectance end
                if data.Enabled ~= nil then obj.Enabled = data.Enabled end
                if data.Scale then obj.Scale = data.Scale end
            end
        end)
    end
    NoVFXPartData = {}

    pcall(function()
        local l = game:GetService("Lighting")
        l.GlobalShadows = true
        l.EnvironmentDiffuseScale = 1
        l.EnvironmentSpecularScale = 1
        l.ShadowSoftness = 0.5
        l.Brightness = 2
        l.ClockTime = 14
        l.FogEnd = 500
        l.FogStart = 0
    end)

    if Connections.VFX then Connections.VFX:Disconnect(); Connections.VFX = nil end
    if Connections.VFXOptimize then Connections.VFXOptimize:Disconnect(); Connections.VFXOptimize = nil end

    print("[NoVFX] Restaurado!")
end

