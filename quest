function iniciarAutoStart()
    if Connections.AutoStart then
        local status = coroutine.status(Connections.AutoStart)
        if status ~= "dead" then
            return
        end
        Connections.AutoStart = nil
    end

    local thread
    thread = task.spawn(function()
        while NightHub.AutoStartAtivo do
            pcall(function()
                fireDungeonStart(1)
                if NightHub.ForceClickAtivo and not ePressedOnStart then
                    ePressedOnStart = true
                    forceClickQ()
                end
            end)
            task.wait(1)
        end

        if Connections.AutoStart == thread then
            Connections.AutoStart = nil
        end
    end)

    Connections.AutoStart = thread
end

function pararAutoStart()
    NightHub.AutoStartAtivo = false
    if Connections.AutoStart then
        pcall(task.cancel, Connections.AutoStart)
        Connections.AutoStart = nil
    end
end

