function iniciarSpammer()
    if Connections.SpamLoop then return end
    LeapingStrikeUsedOnce = false
    LeapingStrikeAutoUsed = false

    task.defer(function()
        for _ = 1, 20 do
            if not NightHub.SpammerAtivo then return end
            usarLeapingStrikeUmaVez()
            if LeapingStrikeAutoUsed then return end
            task.wait(0.1)
        end
    end)

    _toolRemoteCache = {}
    _toolAnimCache = {}

    Connections.SpamLoop = task.spawn(function()
        while NightHub.SpammerAtivo do
            local char = LocalPlayer.Character
            if not char then
            task.wait(0.05)
                continue
            end
            local bp = LocalPlayer:FindFirstChild("Backpack")

            pcall(function()
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local animator = humanoid:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            if track and track.IsPlaying then
                                track:Stop(0)
                            end
                        end
                    end
                end
            end)

            VIM:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
            VIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)

            local tools = {}
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA("Tool") then tools[#tools + 1] = v end
            end
            if bp then
                for _, v in ipairs(bp:GetChildren()) do
                    if v:IsA("Tool") then tools[#tools + 1] = v end
                end
            end

            for ti = 1, #tools do
                local tool = tools[ti]
                if tool.Name ~= "Leaping Strike" then
                    local toolKey = tool:GetFullName()
                    if not _toolRemoteCache[toolKey] then
                        local rems = {}
                        local anims = {}
                        for _, d in ipairs(tool:GetDescendants()) do
                            if d:IsA("RemoteEvent") then rems[#rems + 1] = d end
                            if d:IsA("AnimationTrack") then anims[#anims + 1] = d end
                        end
                        _toolRemoteCache[toolKey] = rems
                        _toolAnimCache[toolKey] = anims
                    end
                    local anims = _toolAnimCache[toolKey]
                    if anims then
                        for i = 1, #anims do
                            local obj = anims[i]
                            if obj and obj.Parent and obj.IsPlaying then obj:Stop(0) end
                        end
                    end
                    -- tool:Activate() removido: disparava cooldown cíclico no jogo
                    local rems = _toolRemoteCache[toolKey]
                    if rems then
                        for i = 1, #rems do
                            local d = rems[i]
                            if d and d.Parent then d:FireServer() end
                        end
                    end
                end
            end

            task.wait()
        end
    end)
end

function pararSpammer()
    if Connections.SpamLoop then
        pcall(task.cancel, Connections.SpamLoop)
        Connections.SpamLoop = nil
        NightHub.SpammerAtivo = false
    end
    _toolRemoteCache = {}
    _toolAnimCache = {}
end

